{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geoarg.local/schema/test.schema.json",
  "title": "GeoArg Test（检验台账一条）",
  "description": "一条检验。契约决定：①每条判废条件与 ceteris paribus 条件都必须挂到某条检验上（挂不上=不可检验=修辞）；②盲法与预注册是独立字段，不是备注；③判别力与通过与否分开记录——通过但无判别力，结论仍是'未判别'。",
  "type": "object",
  "required": [
    "schema_version",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "geoarg/0.7"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Record"
      }
    },
    "claim_id": {
      "type": "string"
    }
  },
  "$defs": {
    "Record": {
      "type": "object",
      "required": [
        "id",
        "name",
        "checks",
        "method",
        "blind",
        "discriminating_power"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Ledger-unique identifier; the contract only requires a non-empty string."
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "被检验对象的 id：前提 P*、ceteris paribus 条件 CP*、判废条件 D*、蕴含 E*"
        },
        "method": {
          "type": "object",
          "required": [
            "type",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "description": "Values may be widened by a domain pack; contract.validate is authoritative."
            },
            "description": {
              "type": "string"
            },
            "implementation": {
              "type": "string",
              "description": "用现成工具还是自写；例：pygplates / 自写最小二乘"
            },
            "threshold": {
              "type": "string",
              "description": "通过判据（写死的阈值，不许事后调）"
            },
            "data_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "blind": {
          "type": "object",
          "required": [
            "is_blind"
          ],
          "additionalProperties": false,
          "properties": {
            "is_blind": {
              "type": "boolean"
            },
            "held_out": {
              "type": "string",
              "description": "留出了什么（盲井、盲断层、盲露头）"
            },
            "preregistered": {
              "type": "boolean",
              "description": "预测是否在见数据之前写下"
            },
            "preregistered_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "discriminating_power": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ],
          "description": "竞争假说是否同样通过。none=该检验不判别（通过也没用）"
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "running",
            "passed",
            "failed",
            "not-run"
          ]
        },
        "result": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number",
              "description": "记录下来的结果值"
            },
            "uncertainty": {
              "type": "object",
              "required": [
                "kind",
                "low",
                "high"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "description": "例如 ci95、range、sd"
                },
                "low": {
                  "type": "number"
                },
                "high": {
                  "type": "number"
                }
              }
            },
            "n": {
              "type": "integer",
              "minimum": 1
            },
            "data_ref": {
              "type": "string",
              "description": "数据在哪里"
            },
            "preregistration": {
              "type": "string",
              "description": "预注册标识或哈希"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "pass_rule": {
          "type": "object",
          "required": [
            "op"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "ge",
                "le",
                "between",
                "within_ci",
                "ratio"
              ]
            },
            "value": {
              "type": "number",
              "description": "ge / le 的阈值"
            },
            "low": {
              "type": "number",
              "description": "between 的下界"
            },
            "high": {
              "type": "number",
              "description": "between 的上界"
            },
            "target": {
              "type": "number",
              "description": "within_ci / ratio 的目标值"
            },
            "tolerance": {
              "type": "number",
              "minimum": 0,
              "description": "ratio 允许的相对偏差"
            }
          }
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "description": "时间/数据/计算成本（同一单位）；成本高的检验要说明为何不可替代"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
