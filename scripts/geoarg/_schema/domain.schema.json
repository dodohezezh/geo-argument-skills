{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geoarg.dev/schema/domain.schema.json",
  "title": "GeoArg domain pack",
  "description": "A domain pack widens enumerations for a case without touching the engine, and may carry field guidance: a default profile, argument patterns, test suggestions, expected evidence families and grounding notes. It is optional; the nearest domain.yaml from the case directory upward applies. Packs can add values but cannot remove or redefine built-in ones.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "enums"
  ],
  "properties": {
    "schema_version": {
      "const": "geoarg/domain/0.1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "enums": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "patterns_dir": {
      "type": "string",
      "minLength": 1,
      "description": "Directory of extra argument patterns, relative to domain.yaml (default: patterns/)."
    },
    "default_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "test_suggestions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method"
              ],
              "properties": {
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "why": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "evidence_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "independence_class": {
                "type": "string",
                "minLength": 1
              },
              "why": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats"
      ],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "pdf",
              "docx",
              "html",
              "markdown",
              "text"
            ]
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
